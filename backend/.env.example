NODE_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
# Optional; leave blank until the business defines a price age policy.
PRICE_MAX_AGE_HOURS=
SESSION_HOURS=8
# Mercado Libre: no subas valores reales a Git. MELI_ACCESS_TOKEN sirve para una prueba manual.
MELI_ACCESS_TOKEN=
# Para ejecución programada: client ID/secret y refresh token inicial de OAuth.
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=
MELI_REFRESH_TOKEN=
# Obligatorio: verifica el tratamiento fiscal de las publicaciones antes de elegir true/false.
MELI_PRICE_INCLUDES_TAX=
MELI_MAX_ITEMS=100
